# ── Backend Environment Variables ─────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit the real .env to Git — it's in .gitignore.

# Port the Express server listens on
PORT=5000

# Environment: development | production
NODE_ENV=development

# MongoDB Atlas connection string
# 1. Go to https://cloud.mongodb.com
# 2. Create a free cluster
# 3. Click Connect → Drivers → copy the connection string
# 4. Replace <username>, <password>, and <cluster-url>
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/markdown-notes?retryWrites=true&w=majority

# The URL of your React frontend — used for CORS
# Development:  http://localhost:5173
# Production:   https://your-app.vercel.app
FRONTEND_URL=http://localhost:5173

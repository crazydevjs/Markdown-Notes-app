# Frontend Environment Variables
# Copy this file to .env and fill in values

# ── Development ──────────────────────────────────────────────────
# Leave empty in development — Vite proxy handles /api → localhost:5000
VITE_API_URL=

# ── Production (Vercel) ──────────────────────────────────────────
# Set this to your Render backend ORIGIN only — do NOT add /api.
# api.js already appends "/api" itself, so adding it here causes a
# broken double path (…/api/api) and every request 404s.
# VITE_API_URL=https://your-backend.onrender.com
